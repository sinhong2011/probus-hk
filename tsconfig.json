{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client", "node", "unplugin-icons/types/solid"],
    "paths": {
      "~/*": ["./src/*"]
      // The linked drawer, from source: its published types are built, and a
      // build that has not been run yet should not be a type error here.
    }
  },
  "include": ["src", "vite.config.ts"]
}
